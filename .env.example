# Nessie API — get your key at https://nessieisreal.com (Capital One "Nessie" mock bank)
# The API is HTTPS-only. http:// is refused at the TCP level, not redirected.
NESSIE_API_KEY=put_your_key_here
NESSIE_BASE_URL=https://api.nessieisreal.com

# Local cache
LANDED_DB=data/landed.db

# Demo anchor. Leave empty to use today's date.
# Everything (history, bills, flight home) is generated relative to this date.
DEMO_AS_OF=

# Deterministic data: same seed -> byte-identical dataset
DEMO_RANDOM_SEED=20260911
