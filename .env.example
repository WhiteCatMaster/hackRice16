# Nessie API — get your key at https://nessieisreal.com (Capital One "Nessie" mock bank)
# The API is HTTPS-only. http:// is refused at the TCP level, not redirected.
NESSIE_API_KEY=put_your_key_here
NESSIE_BASE_URL=https://api.nessieisreal.com

# Local cache
TREASURER_DB=data/treasurer.db

# Demo anchor. Leave empty to use today's date.
# Everything (history, bills, flight home) is generated relative to this date.
DEMO_AS_OF=

# Deterministic data: same seed -> byte-identical dataset
DEMO_RANDOM_SEED=20260911

# --- P3 (API & agent) ---------------------------------------------------
# The chat copilot's model. Set one key; with neither, the agent falls back to
# its scripted router — same tools, same numbers, no model. The demo works
# either way. TREASURER_PROVIDER (gemini|anthropic|scripted) forces one; unset,
# whichever key is present answers, Gemini first.
TREASURER_PROVIDER=

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
TREASURER_GEMINI_MODEL=gemini-flash-latest

# Claude
ANTHROPIC_API_KEY=
TREASURER_MODEL=claude-sonnet-5

# Point the Next.js frontend at this backend. Unset -> it reads mocks/ instead.
# Set this in frontend/.env.local, not here:
#   TREASURER_API_BASE=http://127.0.0.1:8000
