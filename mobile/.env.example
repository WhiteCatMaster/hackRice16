# Leave EXPO_PUBLIC_TREASURER_API_BASE empty and the app reads P1's fixtures,
# bundled by Metro straight out of mocks/ at the repository root. That is the
# default: every screen works with no backend, no API key and no network, which
# is the "mocks first" rule in begin.md §7.
#
# Point it at P3's FastAPI and every screen switches to live data.
#
# EXPO_PUBLIC_ is not decoration: Expo only inlines variables with that prefix
# into the bundle, and this code runs on the phone, so an unprefixed name
# arrives as undefined and the app silently stays in mock mode.
#
# 127.0.0.1 is the phone itself, not your laptop. lib/api.ts rewrites a loopback
# host to the address Metro served the bundle from, so this line works from a
# real device as long as the phone and the laptop are on the same network and
# uvicorn is bound to 0.0.0.0:
#
#   .venv/bin/uvicorn backend.api.app:app --host 0.0.0.0 --port 8000
#
EXPO_PUBLIC_TREASURER_API_BASE=

# Persona shown on launch; the header switches between all three. ana | raj | lucia
EXPO_PUBLIC_TREASURER_USER=ana
