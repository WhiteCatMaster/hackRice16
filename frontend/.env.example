# Leave LANDED_API_BASE empty and the app reads P1's fixtures straight out of
# mocks/ at the repository root. That is the default: the screens work with no
# backend, no API key and no network, which is the "mocks first" rule in
# begin.md §7.
#
# Point it at P3's FastAPI and every screen switches to live data. Nothing else
# changes — the routes under app/api mirror the contract either way.
LANDED_API_BASE=

# Where the fixtures live. Relative paths resolve from frontend/.
LANDED_MOCKS_DIR=../mocks

# Persona shown when the URL has no ?user=. ana | raj | lucia
LANDED_USER=ana
